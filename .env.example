# job-hunt configuration — copy to .env and fill in, then run `make doctor`.
# .env is gitignored; NEVER commit real values.
#
# What does NOT go here, on purpose: passwords, cookies or tokens for Gmail, LinkedIn,
# Naukri or any job board. Gmail is reached through the claude.ai Gmail connector (OAuth,
# Settings → Connectors); job-board logins happen in YOUR browser session (cmux) — Claude
# never logs in or handles credentials.

# ── Identity ───────────────────────────────────────────────────────────
# /setup copies these into .claude/skills/job-application-assistant/01-candidate-profile.md
# (the ONLY source drafts read). `make doctor` flags any mismatch with the profile.
USER_NAME=
USER_EMAIL=
USER_PHONE=
GITHUB_URL=
LINKEDIN_URL=
PORTFOLIO_URL=
LEETCODE_URL=
NAUKRI_PROFILE_URL=

# ── Search preferences (whitelisted into Claude headless runs) ────────
JOB_INTERESTS="software engineer,machine learning engineer"
JOB_LOCATIONS="Bengaluru, India;Remote"

# ── Pipeline ──────────────────────────────────────────────────────────
# ATS score v2 gate (tools/keyword_coverage.py): weighted requirement coverage
# (required x3, preferred x1) and a parseability sub-score. Chosen defaults, not yet
# calibrated against interview outcomes — tune once you have results.
KEYWORD_COVERAGE_THRESHOLD=85
PARSEABILITY_THRESHOLD=80
# File-name stem for published resumes (e.g. firstname_lastname).
RESUME_USERNAME=

# ── Integrations (no secrets) ─────────────────────────────────────────
# The inbox you connected in claude.ai → Connectors → Gmail. Used by /gmail-sync to tell
# your own mail from employers' and by /outreach for the signature.
GMAIL_ADDRESS=
# Days after applying with no reply before /outreach suggests a follow-up email.
FOLLOWUP_AFTER_DAYS=7
# Optional: path to the cmux CLI if it is not on PATH (assisted apply).
# CMUX_BIN=/Applications/cmux.app/Contents/Resources/bin/cmux

# ── Memory (gbrain, optional — pipeline continues without it) ─────────
GBRAIN_SOURCE=jobsearch

# ── Records DB (Docker; NEVER injected into Claude's environment) ─────
DATABASE_URL=postgres://jobhunt:jobhunt@localhost:5436/jobhunt

# ── Resume store (MinIO in Docker; NEVER injected into Claude's env) ──
MINIO_ENDPOINT=http://localhost:9002
MINIO_ACCESS_KEY=jobhunt
MINIO_SECRET_KEY=change-me-local-only
MINIO_BUCKET=resumes

# ── Optional: Overleaf git-bridge (premium accounts only) ─────────────
# OVERLEAF_GIT_URL=

# ── Portal API tokens: placeholders ONLY — add a real secret only when
#    a legitimate supported integration exists (no credential graveyard).
# LINKEDIN_API_TOKEN=
# NAUKRI_API_TOKEN=
# WELLFOUND_API_TOKEN=
# INDEED_API_TOKEN=
