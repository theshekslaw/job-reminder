# ── Secrets & config ──────────────────────────────────────────────
.env
.env.*
.env.local
!.env.example

# ── Personal profile files (dense PII: phone, full history — local-only;
#     a fresh clone runs /setup to generate their own) ─────────────────
.claude/skills/job-application-assistant/01-candidate-profile.md
.claude/skills/job-application-assistant/02-behavioral-profile.md
templates/cv/abhishek-default/template.tex

# ── Personal source documents (PII — used locally, never committed) ──
documents/cv/**
documents/linkedin/**
documents/diplomas/**
documents/references/**
documents/projects/**
documents/applications/**
documents/postings/**
documents/interview/**

# ── Generated application artifacts ───────────────────────────────
# cv/main_example.tex is deliberately NOT re-included (unlike upstream): the
# master CV carries real PII and stays local-only, like resume-example/.
cv/main_*.*
cv/*.txt
cover_letters/cover_*.*
cover_letters/Cover_*.*
resume/
reports/

# ── Runtime state (DB/MinIO volumes, caches, scraper state) ───────
state/
**/job_scraper/seen_jobs.json
**/job_scraper/notion_sync.json
**/job_scraper/*.md
company_research/
company_research/*.json
gmail_sync/
salary_data.json
job_search_tracker.csv
upskill/*.md
**/upskill/report-*.md

# ── PDFs & LaTeX build artifacts ──────────────────────────────────
*.pdf
*_BehavioralReport.pdf
linkedin_Profile.pdf
*.aux
*.log
*.out
*.synctex.gz

# ── Toolchains ────────────────────────────────────────────────────
node_modules/
.venv/
__pycache__/
*.pyc
.pytest_cache/


resume-example/